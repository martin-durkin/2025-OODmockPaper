<Window x:Class="xaml_practice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:xaml_practice"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55*"/>
            <RowDefinition Height="45*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Content="Patients" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" FontWeight="Bold" FontSize="18" Margin="60,20,0,0" VerticalAlignment="Top"/>
        <Label Content="Patient Details" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" FontWeight="Bold" FontSize="18" Margin="60,20,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="tbxFirstName" Grid.Column="1" HorizontalAlignment="Left" Margin="65,90,0,0" GotFocus="TextBox_GotFocus" Text="Enter first name:" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="tbxLastName" Grid.Column="1" HorizontalAlignment="Left" Margin="200,90,0,0" TextWrapping="Wrap" GotFocus="TextBox_GotFocus" Text="Enter last name:" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="tbxPhoneNumber" Grid.Column="1" HorizontalAlignment="Left" Margin="65,135,0,0" TextWrapping="Wrap" GotFocus="TextBox_GotFocus" Text="Enter phone number:" VerticalAlignment="Top" Width="120"/>
        <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="210,140,0,0" Text="DOB" VerticalAlignment="Top"/>
        <DatePicker x:Name="dpDOB" Margin="260,121,95,79" Grid.Column="1"/>
        <Button x:Name="btnAddPatient" Grid.Row="0" Grid.Column="1" Content="Add" HorizontalAlignment="Right" Margin="0,120,10,80" Width="70" Click="btnAddPatient_Click"/>
        <Label Content="Appointments" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" FontWeight="Bold" FontSize="18" Margin="60,20,0,0" VerticalAlignment="Top"/>
        <Button x:Name="btnAddAppointment" Content="Add" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Margin="0,50,20,0" VerticalAlignment="Top" Width="75"/>
        <Button x:Name="btnEditAppointment" Content="Edit" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Margin="0,110,20,0" VerticalAlignment="Top" Width="75"/>

        <ListBox x:Name="lbxPatients" Grid.Row="0" Grid.Column="0" Margin="0,50,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Width="300" Height="185"/>

    </Grid>
</Window>
