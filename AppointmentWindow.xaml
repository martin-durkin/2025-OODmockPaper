<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:xaml_practice"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" x:Class="xaml_practice.AppointmentWindow"
        mc:Ignorable="d"
        Title="AppointmentWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="70*"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="tbxNotes" Grid.Row="1" HorizontalAlignment="Left" Margin="40,0,0,0" VerticalAlignment="Center" Width="550" Height="240" Text="Enter notes" GotFocus="tbx_GotFocus"/>
        <Button x:Name="btnAddAppointment" Content="Add" HorizontalAlignment="Left" Margin="685,184,0,0" Grid.Row="1" VerticalAlignment="Top" Width="78" Click="btnAddAppointment_Click"/>
        <Button x:Name="btnUpdateAppointment" Content="Update" HorizontalAlignment="Left" Margin="685,240,0,0" Grid.Row="1" VerticalAlignment="Top" Click="btnUpdateAppointment_Click"/>
        <Label Content="Notes" HorizontalAlignment="Left" Margin="65,5,0,0" VerticalAlignment="Top" Width="60" Height="27" Grid.Row="1"/>
        <Label Content="Appointment Date" HorizontalAlignment="Left" Margin="65,0,0,0" VerticalAlignment="Center"/>
        <Label Content="Appointment Time" HorizontalAlignment="Left" Margin="453,0,0,0" VerticalAlignment="Center"/>
        <DatePicker x:Name="dpAppointmentDate" HorizontalAlignment="Left" Margin="200,0,0,0" VerticalAlignment="Center"/>
        <materialDesign:TimePicker x:Name="tpAppointmentTime" HorizontalAlignment="Left" Margin="570,0,0,0" VerticalAlignment="Center"/>
    </Grid>
</Window>
